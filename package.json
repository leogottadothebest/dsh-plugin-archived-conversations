{
  "name": "dsh-plugin-archived-conversations",
  "version": "0.1.5",
  "description": "DeepSeek Harness 插件：在设置界面管理已归档对话——取消归档与永久删除。DeepSeek Harness plugin: manage archived conversations in Settings — unarchive and permanently delete.",
  "license": "MIT",
  "author": {
    "name": "leogottadothebest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leogottadothebest/dsh-plugin-archived-conversations.git"
  },
  "homepage": "https://github.com/leogottadothebest/dsh-plugin-archived-conversations#readme",
  "bugs": {
    "url": "https://github.com/leogottadothebest/dsh-plugin-archived-conversations/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "archived-conversations",
    "sessions",
    "archive",
    "settings"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./typert": "./lib/typert.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1 || ^0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1 || ^0.1.5-rc.2",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-rc.1 || ^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs && node --check lib/index.js && node --check lib/remote.js && node --check lib/typert.js && node --check lib/times.js",
    "prepack": "npm run check"
  }
}
